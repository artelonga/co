{
  "name": "co-web",
  "version": "0.0.0",
  "private": true,
  "description": "E2E tests and tooling for co-web",
  "scripts": {
    "test": "npx playwright test --pass-with-no-tests",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:components": "vitest run",
    "openapi:gen": "node --import tsx scripts/generate-openapi.ts",
    "openapi:check": "node --import tsx scripts/generate-openapi.ts --check",
    "scrum:retro": "node --import tsx scripts/scrum/retro-simulate.ts",
    "scrum:retro:forward": "node --import tsx scripts/scrum/retro-simulate.ts --forward",
    "contract:probe": "node --import tsx scripts/contract/probe-staging.ts",
    "scrum:sprint-review": "node --import tsx scripts/scrum/sprint-review.ts",
    "dod:verify": "node --import tsx scripts/dod/verify.ts",
    "test:staging": "npx playwright test --config=e2e-staging/playwright.staging.config.ts",
    "test:staging:headed": "npx playwright test --config=e2e-staging/playwright.staging.config.ts --headed",
    "acceptance:gen": "node --import tsx scripts/scrum/acceptance-to-playwright.ts",
    "acceptance:check": "node --import tsx scripts/scrum/acceptance-to-playwright.ts --check",
    "scrum:cutoff": "node --import tsx scripts/scrum/cutoff-check.ts",
    "scrum:cutoff:override": "node --import tsx scripts/scrum/cutoff-check.ts --ignore-cutoff"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "happy-dom": "^15.11.7",
    "tsx": "^4",
    "vitest": "^3.2.0"
  }
}

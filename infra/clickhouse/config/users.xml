<?xml version="1.0"?>
<clickhouse>
    <users>
        <!-- co_admin: full-access user for analytics queries.
             Password is injected at runtime from the CH_ADMIN_PASSWORD Fly secret.
             Supported since ClickHouse 22.4 via the `from_env` attribute. -->
        <co_admin>
            <password from_env="CH_ADMIN_PASSWORD"/>
            <networks>
                <ip>0.0.0.0/0</ip>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </co_admin>

        <!-- default: no-password user restricted to loopback only (ClickHouse healthcheck). -->
        <default>
            <password></password>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
        </default>
    </users>

    <profiles>
        <default>
            <!-- Reserve ~2 GB headroom for OS + ClickHouse metadata on an 8 GB VM. -->
            <max_memory_usage>6000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
        </default>
        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>

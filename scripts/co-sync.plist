<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.artelonga.co-sync — auto-sync daemon for content universes.

  Runs the `co-sync` Rust binary, which reads ~/projects/co/co-universes.yaml
  (server URL + universe list with parents/visibility), ensures each universe
  exists on prod, pushes all local files, and watches for filesystem changes
  via persistent WebSocket (protobuf SyncDelta + zstd).

  Auth: long-lived API token in macOS Keychain (service=co-sync-token, account=prod).
  Bootstrap once via:
    POST /api/v1/auth/password-login  (admin creds from co-prod-admin keychain)
    POST /api/v1/auth/token { name: "co-sync-launchd" }
    security add-generic-password -a prod -s co-sync-token -U -w "$TOKEN"

  Install:
    launchctl unload ~/Library/LaunchAgents/com.artelonga.co-sync.plist 2>/dev/null
    cp scripts/co-sync.plist ~/Library/LaunchAgents/com.artelonga.co-sync.plist
    launchctl load ~/Library/LaunchAgents/com.artelonga.co-sync.plist
    tail -f ~/.co/co-sync.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.artelonga.co-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /Users/artelonga/.cargo/bin/co-sync "$(security find-generic-password -a prod -s co-sync-token -w)"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>/Users/artelonga/projects/co</string>

    <key>StandardOutPath</key>
    <string>/Users/artelonga/.co/co-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/artelonga/.co/co-sync.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/artelonga/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>RUST_LOG</key>
        <string>co_sync=info,co_agent=info</string>
    </dict>
</dict>
</plist>

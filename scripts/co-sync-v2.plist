<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CO-151 v2 launchd plist — co-agent SyncWatcher via protobuf+zstd WebSocket.

  Migration:
    1. Build co-agent:  cargo build --release -p co-agent
    2. Set CO_SYNC_TOKEN with a valid JWT:
         security add-generic-password -a co-sync -s co-sync -w "$TOKEN"
    3. Load this plist:
         launchctl unload ~/Library/LaunchAgents/com.artelonga.co-sync.plist
         cp scripts/co-sync-v2.plist ~/Library/LaunchAgents/com.artelonga.co-sync.plist
         launchctl load ~/Library/LaunchAgents/com.artelonga.co-sync.plist
    4. Verify:   tail -f ~/.co/launchd-stdout-v2.log

  co-sync.plist (v1, JSON/REST) and co-sync-v2.plist (v2, protobuf/WS) use
  different labels and log files so they can run side-by-side during rollout.
  Disable v1 only after v2 has been stable for 24h:
    launchctl unload ~/Library/LaunchAgents/com.artelonga.co-sync-v1.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.artelonga.co-sync-v2</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Path after `cargo install --path co-agent` or cargo build --release -->
        <string>/Users/artelonga/.cargo/bin/co-agent-watch</string>
        <string>--universe</string>
        <string>$(CO_UNIVERSE_KEY)</string>
        <string>--server-url</string>
        <string>$(CO_SYNC_WS_URL)</string>
        <string>--token</string>
        <string>$(CO_SYNC_TOKEN)</string>
        <string>--watch</string>
        <string>/Users/artelonga/projects/co</string>
    </array>

    <!-- Run continuously: launchd starts at login and restarts on crash. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/artelonga/.co/launchd-stdout-v2.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/artelonga/.co/launchd-stderr-v2.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/artelonga/projects/co</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/artelonga/.cargo/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>CO_UNIVERSE_KEY</key>
        <string>co-dev</string>
        <key>CO_SYNC_WS_URL</key>
        <string>wss://co-artelonga.fly.dev/api/v1/sync/ws</string>
        <!-- CO_SYNC_TOKEN: set via `launchctl setenv CO_SYNC_TOKEN $JWT` or
             read from keychain in a wrapper script. -->
        <key>RUST_LOG</key>
        <string>co_agent=info</string>
    </dict>
</dict>
</plist>
